# KICK of another member removes it. KICK or PART of ourselves parts the
# buffer: it stays in the sidebar with no members, topic or modes, and
# lines for it are dropped until we join again.
! welcome
< :irc.test 005 textual CHANTYPES=# :are supported by this server
< :textual!u@h JOIN #c
> MODE #c
< :irc.test 332 textual #c :the topic
< :irc.test 353 textual = #c :@op textual bob
< :irc.test 366 textual #c :End of NAMES list
> WHO #c
< :irc.test 315 textual #c :End of WHO list
< :irc.test 324 textual #c +nt
< :op!o@h KICK #c bob :spam
? line #c op kicked bob from the channel (spam)
? members #c = @op textual
< :op!o@h KICK #c textual :bye
? line #c op kicked textual from the channel (bye)
? parted #c
? members #c =
? topic #c none
? modes #c
? buffers = console #c
? lines #c 5
< :op!o@h PRIVMSG #c :you cannot see this
< :op!o@h KICK #c textual :again
? lines #c 5
< :textual!u@h JOIN #c
> MODE #c
? joined #c
? members #c = textual
< :textual!u@h PART #c :done
? line #c textual (u@h) left the channel (done)
? parted #c
? members #c =
? registered textual
